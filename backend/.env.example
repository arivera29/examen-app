DATABASE_URL=postgresql://examen:examen123@localhost:5432/examen_db
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:4200
# Orígenes permitidos por CORS (separados por coma). Incluye tu URL de ngrok si usas túnel aparte.
CORS_ORIGINS=http://localhost:4200
# Permite dominios *.ngrok-free.app y *.ngrok.app en desarrollo
CORS_ALLOW_NGROK=true
# Proveedor de correo: smtp | mailtrap | mock
# Para Docker: copia este archivo a backend/.env y configura Mailtrap aquí
EMAIL_PROVIDER=mailtrap
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_EMAIL=hello@demomailtrap.com
MAILTRAP_FROM_NAME=Examen App
MAILTRAP_CATEGORY=Examen App
MAX_VIDEO_UPLOAD_SIZE_MB=128

# Desarrollo local con MailHog (opcional)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
